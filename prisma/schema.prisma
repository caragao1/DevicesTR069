generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler), usada apenas por `prisma migrate`.
  // Se o seu Postgres não usa pooler (pgbouncer), aponte para a mesma URL de DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// role: ADMIN | MEMBRO (ver src/lib/constants.ts)
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           String    @default("MEMBRO")
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  acsSession AcsSession?
}

model DeviceModel {
  id           String   @id @default(cuid())
  manufacturer String
  modelName    String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  limitations Limitation[]

  @@unique([manufacturer, modelName])
}

// severity: BAIXA | MEDIA | ALTA | CRITICA
// status: CONHECIDO | EM_ANALISE | RESOLVIDO
// Mantidos como String (em vez de enum do Postgres) e validados em app code (ver src/lib/constants.ts).
model Limitation {
  id               String   @id @default(cuid())
  deviceModelId    String
  deviceModel      DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)
  title            String
  category         String
  severity         String
  description      String
  affectedFirmware String?
  workaround       String?
  status           String   @default("CONHECIDO")
  referenceLink    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([deviceModelId])
}

// Capacidades de um equipamento (hardware + firmware), obtidas via a API do
// ACS do cliente no momento do registro. Um modelo pode ter várias
// combinações de hardware/firmware, cada uma com seu próprio conjunto de
// capacidades suportadas — por isso a chave é composta pelos quatro campos.
model EquipmentCapability {
  id              String    @id @default(cuid())
  manufacturer    String
  modelName       String
  productClass    String?
  hardware        String
  firmwareVersion String
  releaseDate     DateTime?
  packageVersion  String?
  datamodel       String?
  hasPackage      Boolean?
  serialNumber    String?
  // Estrutura da API do ACS, aninhada e específica de cada fabricante/modelo
  // — guardada como JSON e renderizada de forma genérica (ver CapabilityGroupsPanel).
  capabilities    Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([manufacturer, modelName, hardware, firmwareVersion])
}

// Sessão de autenticação com o ACS de um cliente (1 por usuário): guarda o
// bearer token já obtido para reaproveitar em novos registros sem repetir
// client_id/client_secret, até expirar ou até o usuário trocar de domínio.
// O token nunca é guardado em texto puro (ver src/lib/crypto.ts).
model AcsSession {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain               String
  accessTokenEncrypted String
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
