# Banco Postgres. No Vercel, se você criar um Postgres pelo próprio dashboard
# (Storage → Create Database), essas variáveis já vêm com os nomes corretos
# preenchidos automaticamente no projeto — não precisa copiar nada manualmente.
#
# DATABASE_URL: conexão "pooled" (com pgbouncer), usada em runtime pela aplicação.
# DIRECT_URL:   conexão direta (sem pooler), usada apenas pelo `prisma migrate`.
#               Se seu Postgres não tiver pooler, use o mesmo valor nas duas.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

AUTH_SECRET="troque-por-um-valor-aleatorio-longo-em-producao"
ADMIN_EMAIL="admin@ixcacs.local"
ADMIN_PASSWORD="defina-uma-senha-forte"

# Chave usada para criptografar (AES-256-GCM) o bearer token salvo ao
# registrar um equipamento de Capacidades. Precisa ter exatamente 32 bytes
# em base64 — gere com: openssl rand -base64 32
ACS_TOKEN_ENCRYPTION_KEY="troque-por-uma-chave-base64-de-32-bytes"
